# Copy to .env.local for local dev. Do NOT commit .env.local (it's gitignored).
# In production these are set in the Railway dashboard, not in a file.

# Public base URL of the app. Read by the Hono RPC client (app/api/client.ts).
# Must be prefixed NEXT_PUBLIC_ to be exposed to the browser, and is inlined at
# build time (changing it requires a rebuild/redeploy).
#   local:      http://localhost:3000
#   production: the Railway-generated domain, e.g. https://tasker-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Appwrite — server-side only, never prefix with NEXT_PUBLIC_.
# Get these from the Appwrite console (Project settings + API Keys).
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_PROJECT_NAME=
APPWRITE_API_KEY=
